# مسیر پایگاه داده و فهرست منابع
RASAD_DB=./data/rasad.db
RASAD_SOURCES=./sources.yaml
# سطح اجرا: manual | supervised | autopilot  — فاصله اجرای خودکار (ثانیه)
RASAD_MODE=supervised
RASAD_INTERVAL=900
# دروازه‌های تأیید انسانی در حالت نظارتی
RASAD_GATES=writer,alerts
# استخراج متن کامل
RASAD_FULLTEXT=1
RASAD_FULLTEXT_PER_RUN=60
RASAD_FETCH_CONCURRENCY=8
# احراز هویت و نقش‌ها (1 = فعال؛ 0 فقط برای توسعه محلی)
RASAD_AUTH=1
# ساخت خودکار حساب مدیر در اولین اجرا (اختیاری؛ در غیر این صورت صفحه «راه‌اندازی اولیه» نمایش داده می‌شود)
RASAD_ADMIN_USER=
RASAD_ADMIN_PASSWORD=
# پشت HTTPS روی 1 بگذارید (کوکی Secure)
RASAD_COOKIE_SECURE=0
# آدرس عمومی برای پیوندهای داخل اعلان‌ها
RASAD_PUBLIC_URL=http://localhost:8080
# منطقه زمانی خلاصه روزانه
RASAD_TZ=Asia/Tehran
# نگهداری داده (روز) و تعداد نسخه‌های پشتیبان
RASAD_RETENTION_DAYS=60
RASAD_BACKUP_KEEP=7
# توکن قدیمی برای اسکریپت‌ها (هدر X-Admin-Token = دسترسی مدیر)
RASAD_ADMIN_TOKEN=
# هوش مصنوعی — هر endpoint سازگار با OpenAI (Vyce / LiteLLM / Ollama / vLLM)
LLM_BASE_URL=
# کلید API خود را بعد از = بگذارید (یا از صفحه تنظیمات هوش مصنوعی وارد کنید)
LLM_API_KEY=
LLM_MODEL=qwen3:8b
LLM_FALLBACK_MODEL=
LLM_DAILY_TOKEN_BUDGET=3000000
# سقف درخواست در دقیقه به فراهم‌کننده
LLM_RPM=20

# تحلیل مستند: قابلیت‌ها فقط پس از آزمون فراهم‌کننده فعال شوند
# خروجی json_schema از تنظیمات هوش مصنوعی فعال می‌شود؛ پیش‌فرض خاموش است.
# embedding مستقل از API گفتگو است و کلید مستقل دارد
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=bge-m3
RASAD_EMBEDDING_DAILY_REQUESTS=100
# ارسال تصویر/صوت به API خارجی صریحاً اختیاری است
RASAD_MEDIA_API=0
RASAD_TRANSCRIPTION_MODEL=whisper-1
RASAD_TRANSCRIPTION_DAILY_REQUESTS=20
# حاشیه رزرو بودجه توکن گفتگو؛ جایگزین سقف هزینه فراهم‌کننده نیست
LLM_TOKEN_OVERHEAD=5000
# هنگام Docker در volume داده نگهداری شود
RASAD_BACKUP_DIR=./data/backups

# دریافت صریح سند بیرونی؛ راستی‌آزمایی خودکار خبر نیست
RASAD_EXTERNAL_FETCH=0
# فقط نام دامنه دقیق و بدون wildcard، جداشده با کاما
RASAD_EXTERNAL_ALLOWED_HOSTS=
RASAD_EXTERNAL_DAILY_IMPORTS=10
# بازبین تأییدکننده باید غیر از مالک/ویرایشگر و دارای حساب فعال باشد
RASAD_REQUIRE_SECOND_REVIEWER=0
